{
  "name": "kimi-k27-code-for-copilot",
  "displayName": "Kimi K2.7 Code for Copilot Chat",
  "description": "Use Kimi K2.7 Code from the Copilot Chat model picker. Native vision, always-on thinking, agent tools — zero config, BYOK.",
  "icon": "resources/icon.png",
  "version": "0.1.1",
  "publisher": "tsing-xl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsing-xl/kimi-k27-code-for-copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "kimi",
    "kimi k2.7",
    "kimi-k2.7",
    "kimi-k2.7-code",
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "moonshot",
        "displayName": "Moonshot"
      }
    ],
    "commands": [
      {
        "command": "kimi-copilot.setApiKey",
        "title": "%kimi-copilot.command.setApiKey%"
      },
      {
        "command": "kimi-copilot.getApiKey",
        "title": "%kimi-copilot.command.getApiKey%"
      },
      {
        "command": "kimi-copilot.clearApiKey",
        "title": "%kimi-copilot.command.clearApiKey%"
      },
      {
        "command": "kimi-copilot.openSettings",
        "title": "%kimi-copilot.command.openSettings%"
      },
      {
        "command": "kimi-copilot.showLogs",
        "title": "%kimi-copilot.command.showLogs%"
      },
      {
        "command": "kimi-copilot.openRequestDumpsFolder",
        "title": "%kimi-copilot.command.openRequestDumpsFolder%"
      }
    ],
    "walkthroughs": [
      {
        "id": "kimiGettingStarted",
        "title": "%kimi-copilot.walkthrough.title%",
        "description": "%kimi-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%kimi-copilot.walkthrough.setApiKey.title%",
            "description": "%kimi-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:kimi-copilot.setApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%kimi-copilot.walkthrough.showModels.title%",
            "description": "%kimi-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%kimi-copilot.walkthrough.advancedSettings.title%",
            "description": "%kimi-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%kimi-copilot.config.title%",
      "properties": {
        "kimi-copilot.baseUrl": {
          "type": "string",
          "default": "https://api.moonshot.cn",
          "description": "%kimi-copilot.config.baseUrl.description%"
        },
        "kimi-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%kimi-copilot.config.maxTokens.description%"
        },
        "kimi-copilot.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%kimi-copilot.config.experimental.stabilizeToolList.description%",
          "tags": [
            "experimental"
          ]
        },
        "kimi-copilot.modelIdOverrides": {
          "type": "object",
          "default": {
            "kimi-k2.7-code": "kimi-k2.7-code",
            "kimi-k2.7-code-highspeed": "kimi-k2.7-code-highspeed"
          },
          "description": "%kimi-copilot.config.modelIdOverrides.description%",
          "additionalProperties": false,
          "properties": {
            "kimi-k2.7-code": {
              "type": "string",
              "description": "%kimi-copilot.config.modelIdOverrides.kimi-k2.7-code.description%"
            },
            "kimi-k2.7-code-highspeed": {
              "type": "string",
              "description": "%kimi-copilot.config.modelIdOverrides.kimi-k2.7-code-highspeed.description%"
            }
          }
        },
        "kimi-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%kimi-copilot.config.debugMode.minimal.label%",
            "%kimi-copilot.config.debugMode.metadata.label%",
            "%kimi-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%kimi-copilot.config.debugMode.minimal.description%",
            "%kimi-copilot.config.debugMode.metadata.description%",
            "%kimi-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%kimi-copilot.config.debugMode.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "lint": "oxlint",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "package": "vsce package --readme-path dist/README.marketplace.md -o dist/",
    "login": "vsce login Vizards"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "ovsx": "0.10.12",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
