{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "silent"
			},
			"group": "build"
		},
		{
			"label": "Launch Extension Host (Insiders CLI)",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/.vscode/launch-extension-host.sh",
				"insiders",
				"9333",
				"${workspaceFolder}"
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.vscode/launch-extension-host.ps1",
					"insiders",
					"9333",
					"${workspaceFolder}"
				]
			},
			"dependsOn": "npm: watch",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Launch Extension Host (Stable CLI)",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/.vscode/launch-extension-host.sh",
				"stable",
				"9334",
				"${workspaceFolder}"
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/.vscode/launch-extension-host.ps1",
					"stable",
					"9334",
					"${workspaceFolder}"
				]
			},
			"dependsOn": "npm: watch",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "compile-check",
			"type": "shell",
			"command": "npx tsc --noEmit",
			"isBackground": false
		},
		{
			"label": "compile-check2",
			"type": "shell",
			"command": "npx tsc --noEmit 2>&1 | head -30",
			"isBackground": false
		},
		{
			"label": "compile-check3",
			"type": "shell",
			"command": "npx tsc --noEmit",
			"isBackground": false
		},
		{
			"label": "compile-final",
			"type": "shell",
			"command": "npx tsc --noEmit",
			"isBackground": false
		},
		{
			"label": "compile",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-prompt-cache",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-moonshot",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-nls",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-novision",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-delvision",
			"type": "shell",
			"command": "npx tsc -p ./ 2>&1 | Select-String -Pattern \"error TS\"",
			"isBackground": false
		},
		{
			"label": "compile-final2",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "quality-check",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "quality-final",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "compile-readme",
			"type": "shell",
			"command": "npm run compile",
			"isBackground": false
		},
		{
			"label": "package-vsix",
			"type": "shell",
			"command": "npx vsce package --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix2",
			"type": "shell",
			"command": "npx vsce package --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix3",
			"type": "shell",
			"command": "npm run compile && npx vsce package --no-yarn --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix4",
			"type": "shell",
			"command": "npm run compile; npx vsce package --no-dependencies --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix-final",
			"type": "shell",
			"command": "npx vsce package --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix-ok",
			"type": "shell",
			"command": "mkdir dist; npx vsce package --out dist/kimi-k27-code-for-copilot-0.1.0.vsix",
			"isBackground": false
		},
		{
			"label": "package-vsix-0.1.2",
			"type": "shell",
			"command": "npx vsce package --out dist/kimi-k27-code-for-copilot-0.1.2.vsix",
			"isBackground": false
		}
	]
}